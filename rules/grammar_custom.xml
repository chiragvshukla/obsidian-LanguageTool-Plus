<rules>
  <category id="LT_PLUS" name="LanguageToolPlus">
    <rule id="LT_PLUS_DOPPELTES_UND" name="Doppeltes „und“">
      <pattern>
        <token case_sensitive="no">und</token>
        <token case_sensitive="no">und</token>
      </pattern>
      <message>Doppeltes „und“. Streiche eines davon.<suggestion>und</suggestion></message>
      <example correction="und">Wir gehen <marker>und und</marker> kommen wieder.</example>
    </rule>
  </category>
</rules>