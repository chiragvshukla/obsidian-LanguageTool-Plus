# Copy to .env for local development. Never commit .env.
# Values here are placeholders only; no secrets belong in this file.

# LanguageTool server (self-hosted, unmodified)
LT_URL=http://127.0.0.1:8010
LT_TIMEOUT_SECONDS=10

# OpenAI-compatible LLM endpoint. Used from Phase 3 (rewrite).
# Ollama exposes this at /v1; any compatible provider works.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma4:e4b-it-q4_K_M
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
LLM_CONTEXT_CHARS=12000
LLM_CACHE_SIZE=128

# Gateway
LOG_LEVEL=INFO
DEFAULT_MODE=neutral
DEFAULT_LANGUAGE=de-DE

# Paths (relative to gateway/; defaults need no override)
MODES_DIR=../modes
RULES_DIR=../rules
PROMPTS_DIR=../prompts
DICTIONARY_DIR=../data/dictionary